POSTGRES_DB=margin
POSTGRES_USER=margin
POSTGRES_PASSWORD=margin
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173
DATABASE_URL=postgresql+psycopg://margin:margin@localhost:5432/margin
VITE_API_URL=http://127.0.0.1:8000

# Optional companion model override (NVIDIA hosted API)
MARGIN_CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Default for Ask Margin's agent mode when a request doesn't say (the UI toggle does)
MARGIN_AGENT=0
# Optional: a different model for agent mode (defaults to MARGIN_CHAT_MODEL)
# MARGIN_AGENT_MODEL=nvidia/nemotron-3.5-bolt-e4b
# MARGIN_AGENT_TIMEOUT=30
# Agent router: tune with `uv run python benchmarks/router_eval.py` (conservative defaults below)
# MARGIN_ROUTER_THRESHOLD=0.70
# MARGIN_ROUTER_MARGIN=0.05
